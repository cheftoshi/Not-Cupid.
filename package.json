{
  "name": "notcupid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test e2e/public-mobile.spec.ts",
    "test:e2e:https": "node scripts/run-public-mobile-https.mjs",
    "test:e2e:auth": "playwright test e2e/authenticated-mobile.spec.ts",
    "test:e2e:release": "E2E_REQUIRE_AUTH=1 playwright test e2e/authenticated-mobile.spec.ts",
    "performance:budget": "node scripts/check-client-budgets.mjs",
    "ci:check": "npm run typecheck && npm test && npm run build && npm run performance:budget",
    "audit:experiment-model": "node scripts/audit-experiment-model.mjs",
    "audit:matching": "node --env-file-if-exists=.env.local scripts/evaluate-matching.mjs",
    "security:check": "npm audit --audit-level=low && npm run typecheck && npm test",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@supabase/supabase-js": "2.115.0",
    "next": "16.3.4",
    "openai": "7.10.0",
    "react": "^18",
    "react-dom": "^18",
    "resend": "6.26.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "sharp": "0.35.4",
    "typescript": "^5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
